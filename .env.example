POSTGRES_PASSWORD=
API_USERNAME=homarr
API_PASSWORD=
API_PORT=4000

# PostgreSQL for VS Code and compose.db.yaml.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=power_dashboard
PGUSER=power_dashboard
PGPASSWORD=

# Generate the dashboard session secret with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=
# Set to false only for local HTTP testing.
DASHBOARD_SECURE_COOKIE=true

# Set all five values to register a station on startup.
STATION_ID=
STATION_NAME=
STATION_MODEL=
STATION_DEVICE_ID=
STATION_BLE_MAC=

# Optional. Defaults to the OS running the worker.
# BLE_HOST_OS=macos
BLE_ADAPTER=hci0
POLL_INTERVAL_MS=1000
STALE_AFTER_MS=5000

# Optional worker notifications. Give the bot permission to post in the channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LOW_BATTERY_PCT=20
# Optional DTEK Kyiv region queue, for example 4.1.
TELEGRAM_DTEK_QUEUE=
